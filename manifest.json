{
  "manifest_version": 3,
  "name": "ShieldX – Bloqueador Total",
  "version": "11.8",
  "description": "Bloquea anuncios, rastreadores, resultados patrocinados y banners de cookies. Sin excepciones.",
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none';"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "tabs",
    "downloads",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "sx-toggle-site": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Activar o excluir ShieldX en este sitio"
    },
    "sx-pick": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Señalar un elemento para ocultarlo"
    },
    "sx-cookie-show": {
      "description": "Volver a mostrar el aviso de cookies de esta página"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_ads",
        "enabled": true,
        "path": "rules/ads.json"
      },
      {
        "id": "ruleset_redirect",
        "enabled": true,
        "path": "rules/redirect.json"
      },
      {
        "id": "ruleset_cleanurl",
        "enabled": true,
        "path": "rules/cleanurl.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}